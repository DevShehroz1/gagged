{%- liquid
  assign sec_st = section.settings
  assign mt_mobile = sec_st.margin_top_mobile
  if mt_mobile == 0
    assign mt_mobile = sec_st.margin_top_desktop
  endif
  assign mb_mobile = sec_st.margin_bottom_mobile
  if mb_mobile == 0
    assign mb_mobile = sec_st.margin_bottom_desktop
  endif
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    margin-top: {{ sec_st.margin_top_desktop | default: 0 }}px !important;
    margin-bottom: {{ sec_st.margin_bottom_desktop | default: 0 }}px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    padding: 0 !important;
    display: block;
    width: 100%;
  }
  @media (max-width: 767.98px) {
    #shopify-section-{{ section.id }} {
      margin-top: {{ mt_mobile | default: 0 }}px !important;
      margin-bottom: {{ mb_mobile | default: 0 }}px !important;
    }
  }
{% endstyle %}

<style>
  #icon-row-{{ section.id }} {
    background: {{ sec_st.bg_color | default: '#363B47' }};
    width: 100%;
    padding-top: {{ sec_st.padding_top_desktop | default: 40 }}px;
    padding-bottom: {{ sec_st.padding_bottom_desktop | default: 40 }}px;
  }
  #icon-row-{{ section.id }} .ir__inner {
    max-width: {{ sec_st.content_max_width | default: 1280 }}px;
    margin: 0 auto;
    padding-left: 32px;
    padding-right: 32px;
  }
  #icon-row-{{ section.id }} .ir__row {
    display: grid;
    grid-template-columns: repeat({{ section.blocks.size | at_least: 1 }}, 1fr);
    gap: {{ sec_st.column_gap_desktop | default: 32 }}px;
    align-items: start;
    justify-items: center;
  }
  #icon-row-{{ section.id }} .ir__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    width: 100%;
  }
  #icon-row-{{ section.id }} .ir__icon {
    width: {{ sec_st.icon_size_desktop | default: 56 }}px;
    height: {{ sec_st.icon_size_desktop | default: 56 }}px;
    object-fit: contain;
    display: block;
    margin-bottom: {{ sec_st.icon_label_gap | default: 18 }}px;
  }
  #icon-row-{{ section.id }} .ir__label {
    font-family: 'Inter', var(--body-font), sans-serif;
    font-size: {{ sec_st.label_size_desktop | default: 11 }}px;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: {{ sec_st.label_color | default: '#FFF8B8' }};
    margin: 0;
    max-width: 220px;
  }
  @media (max-width: 767.98px) {
    #icon-row-{{ section.id }} {
      padding-top: {{ sec_st.padding_top_mobile | default: 32 }}px;
      padding-bottom: {{ sec_st.padding_bottom_mobile | default: 32 }}px;
    }
    #icon-row-{{ section.id }} .ir__inner {
      padding-left: 16px;
      padding-right: 16px;
    }
    #icon-row-{{ section.id }} .ir__row {
      grid-template-columns: repeat({{ sec_st.columns_mobile | default: 2 }}, 1fr);
      gap: {{ sec_st.column_gap_mobile | default: 20 }}px {{ sec_st.column_gap_mobile | default: 20 }}px;
      row-gap: {{ sec_st.row_gap_mobile | default: 28 }}px;
    }
    #icon-row-{{ section.id }} .ir__icon {
      width: {{ sec_st.icon_size_mobile | default: 44 }}px;
      height: {{ sec_st.icon_size_mobile | default: 44 }}px;
      margin-bottom: {{ sec_st.icon_label_gap_mobile | default: 12 }}px;
    }
    #icon-row-{{ section.id }} .ir__label {
      font-size: {{ sec_st.label_size_mobile | default: 9 }}px;
      letter-spacing: 0.1em;
    }
  }
</style>

<section id="icon-row-{{ section.id }}" class="icon-row">
  <div class="ir__inner">
    <div class="ir__row">
      {%- for block in section.blocks -%}
        {%- assign tag = 'div' -%}
        {%- if block.settings.link != blank -%}
          {%- assign tag = 'a' -%}
        {%- endif -%}
        <{{ tag }}
          class="ir__item"
          {% if tag == 'a' %}href="{{ block.settings.link }}"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.icon != blank -%}
            {{ block.settings.icon | image_url: width: 200 | image_tag: class: 'ir__icon', alt: block.settings.label | default: '', loading: 'lazy' }}
          {%- endif -%}
          {%- if block.settings.label != blank -%}
            <p class="ir__label">{{ block.settings.label | escape }}</p>
          {%- endif -%}
        </{{ tag }}>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Icon Row",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#363B47"
    },
    {
      "type": "color",
      "id": "label_color",
      "label": "Label color",
      "default": "#FFF8B8"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Content max width",
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1280
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Icon size (desktop)",
      "min": 24,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Icon size (mobile)",
      "min": 20,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "icon_label_gap",
      "label": "Gap between icon and label (desktop)",
      "min": 0,
      "max": 60,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "icon_label_gap_mobile",
      "label": "Gap between icon and label (mobile)",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Labels"
    },
    {
      "type": "range",
      "id": "label_size_desktop",
      "label": "Label size (desktop)",
      "min": 8,
      "max": 22,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "range",
      "id": "label_size_mobile",
      "label": "Label size (mobile)",
      "min": 7,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 9
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "column_gap_desktop",
      "label": "Column gap (desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "column_gap_mobile",
      "label": "Column gap (mobile)",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Row gap (mobile)",
      "info": "Vertical gap between rows when icons wrap.",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 28
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "4", "label": "4 (single row)" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding top (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding bottom (desktop)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Padding top (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Padding bottom (mobile)",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "Margins"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Margin top (desktop)",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Margin bottom (desktop)",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Margin top (mobile)",
      "info": "Falls back to the desktop value when 0.",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Margin bottom (mobile)",
      "info": "Falls back to the desktop value when 0.",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "blocks": [
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "SKIN FIRST ACTIVES"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Icon Row",
      "blocks": [
        { "type": "icon", "settings": { "label": "SKIN FIRST ACTIVES" } },
        { "type": "icon", "settings": { "label": "INDIA'S 1ST REFILLABLE FORMULA" } },
        { "type": "icon", "settings": { "label": "ZERO HARSH CHEMICALS" } },
        { "type": "icon", "settings": { "label": "PROPRIETARY BIOTECH COMPLEX™" } }
      ]
    }
  ]
}
{% endschema %}
