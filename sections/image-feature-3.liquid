{%- liquid
  assign s = section.settings
  if s.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}

<div class="ss{{ reset_spacing }}" style="background-color: {{ s.bg_color }};">
  <div class="ss__wrap" style="padding: {{ s.section_padding_v }}px {{ s.section_padding_h }}px;">
    <div class="ss__block">

      <div class="ss__image-panel">
        {%- if s.image != blank -%}
          {{
            s.image
            | image_url: width: 1400
            | image_tag:
              loading: 'lazy',
              alt: s.image.alt | default: 'Story image',
              class: 'ss__img',
              widths: '400, 700, 1000, 1400',
              sizes: '(max-width: 960px) 100vw, 55vw'
          }}
        {%- else -%}
          {{ 'image' | placeholder_svg_tag: 'ss__img ss__img--placeholder' }}
        {%- endif -%}
      </div>

      <div class="ss__copy">
        {%- if s.heading_1 != blank -%}
          <h3 class="ss__heading-1" style="color: {{ s.heading_1_color }};">
            {%- if s.show_heading_dot -%}<span class="ss__dot" aria-hidden="true"></span>{%- endif -%}
            {%- if s.heading_1_typewriter -%}
              {%- assign tw_parts = s.heading_1 | strip_html | split: '|' -%}
              <span
                class="ss__heading-1-text ss__heading-1-text--typewriter"
                data-typewriter-phrases="{{ tw_parts | json | escape }}"
              >{{ tw_parts.first | strip | escape }}</span>
            {%- else -%}
              <span class="ss__heading-1-text">{{ s.heading_1 }}</span>
            {%- endif -%}
          </h3>
        {%- endif -%}

        {%- if s.heading_2 != blank -%}
          <h2 class="ss__headline" style="color: {{ s.heading_2_color }};">{{ s.heading_2 | newline_to_br }}</h2>
        {%- endif -%}

        {%- if s.description != blank -%}
          <p class="ss__desc" style="color: {{ s.description_color }};">
            {{ s.description | newline_to_br }}
          </p>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} br {
    display: inline;
  }
  #shopify-section-{{ section.id }} {
    padding-left: {{ s.side_margin_desktop | default: 0 }}px;
    padding-right: {{ s.side_margin_desktop | default: 0 }}px;
  }
  @media (max-width: 640px) {
    #shopify-section-{{ section.id }} {
      padding-left: {{ s.side_margin_mobile | default: 0 }}px;
      padding-right: {{ s.side_margin_mobile | default: 0 }}px;
    }
  }
  #shopify-section-{{ section.id }} .ss {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .ss__wrap {
    display: grid;
    place-items: center;
  }

  #shopify-section-{{ section.id }} .ss__block {
    width: min(100%, {{ s.content_max_width }}px);
    background: {{ s.bg_color }};
    border-radius: 24px;
    padding: {{ s.block_padding }}px;
    display: grid;
    grid-template-columns: {{ s.image_col_pct }}% 1fr;
    gap: {{ s.column_gap }}px;
    align-items: stretch;
    isolation: isolate;
    overflow: visible;
  }

  {%- if s.image_position == 'right' -%}
  #shopify-section-{{ section.id }} .ss__block {
    direction: rtl;
  }
  #shopify-section-{{ section.id }} .ss__image-panel,
  #shopify-section-{{ section.id }} .ss__copy {
    direction: ltr;
  }
  {%- endif -%}

  #shopify-section-{{ section.id }} .ss__image-panel {
    position: relative;
    z-index: 1;
    border-radius: 0;
    overflow: hidden;
    align-self: start;
    background: transparent;
    line-height: 0;
  }
  #shopify-section-{{ section.id }} .ss__img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .ss__img--placeholder {
    width: 100%;
    aspect-ratio: 1 / 1;
    display: block;
  }

  #shopify-section-{{ section.id }} .ss__copy {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 8px 8px 8px {{ s.content_padding_left | default: 2 }}px;
    min-height: 400px;
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .ss__heading-1 {
    position: relative;
    z-index: 3;
    margin: 0 0 {{ s.heading_gap | default: 14 }}px;
    display: flex;
    align-items: center;
    font-family: 'Inter', 'Avenir Next', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: {{ s.heading_1_size | default: 16 }}px;
    line-height: 1.2;
    letter-spacing: 0;
    font-weight: {{ s.heading_1_weight | default: 500 }};
    text-transform: {{ s.heading_1_case | default: 'uppercase' }};
    width: calc(100% + {{ s.heading_overlap }}px);
    max-width: 860px;
    margin-left: -{{ s.heading_overlap }}px;
  }
  #shopify-section-{{ section.id }} .ss__dot {
    display: inline-block;
    flex: none;
    width: {{ s.heading_dot_size | default: 10 }}px;
    height: {{ s.heading_dot_size | default: 10 }}px;
    border-radius: 50%;
    background: {{ s.heading_dot_color | default: '#01c78e' }};
    margin-right: {{ s.heading_dot_gap | default: 8 }}px;
    animation: ss-dot-blink 0.6s ease-in-out infinite alternate;
  }
  @keyframes ss-dot-blink {
    from { opacity: 1; }
    to   { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ss__dot { animation: none; }
  }

  #shopify-section-{{ section.id }} .ss__headline {
    position: relative;
    z-index: 3;
    margin: 0;
    font-family: 'Inter', 'Avenir Next', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: {{ s.heading_size }}px;
    line-height: {{ s.heading_line_height_x10 | default: 13 | divided_by: 10.0 }};
    letter-spacing: 0;
    font-weight: 500;
    font-style: normal;
    text-transform: {{ s.heading_2_case | default: 'uppercase' }};
    width: calc(100% + {{ s.heading_overlap }}px);
    max-width: {{ s.heading_max_width | default: 860 }}px;
    margin-left: -{{ s.heading_overlap }}px;
    color: {{ s.heading_2_color | default: '#111111' }};
    overflow: visible;
  }

  #shopify-section-{{ section.id }} .ss__desc {
    position: relative;
    top: {{ s.desc_offset_y | default: 0 }}px;
    margin: 0;
    max-width: {{ s.desc_max_width }}px;
    font-family: 'Inter', 'Avenir Next', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: {{ s.desc_size }}px;
    line-height: 24px;
    letter-spacing: 0;
    font-weight: 400;
    font-style: normal;
    align-self: flex-start;
    padding-top: 20px;
  }

  @media screen and (max-width: 1200px) and (min-width: 961px) {
    #shopify-section-{{ section.id }} .ss__heading-1,
    #shopify-section-{{ section.id }} .ss__headline {
      margin-left: clamp(-{{ s.heading_overlap }}px, -6.2vw, -{{ s.heading_overlap | minus: 30 }}px);
    }
  }

  @media screen and (max-width: 960px) {
    #shopify-section-{{ section.id }} .ss__block {
      grid-template-columns: 1fr;
    }
    #shopify-section-{{ section.id }} .ss__copy {
      min-height: auto;
      gap: 22px;
    }
    #shopify-section-{{ section.id }} .ss__heading-1,
    #shopify-section-{{ section.id }} .ss__headline {
      margin-left: 0;
      width: 100%;
      max-width: 100%;
    }
    #shopify-section-{{ section.id }} .ss__headline {
      font-size: {{ s.heading_size | minus: 8 }}px;
    }
    #shopify-section-{{ section.id }} .ss__desc {
      font-size: {{ s.desc_size | minus: 2 }}px;
      padding-top: 0;
    }
  }

  @media screen and (max-width: 640px) {
    #shopify-section-{{ section.id }} {
      display: none;
    }
    #shopify-section-{{ section.id }} .ss__wrap {
      padding: 24px 12px;
    }
    #shopify-section-{{ section.id }} .ss__block {
      position: relative;
      padding: 0;
      background: transparent;
      border-radius: 0;
      gap: 0;
    }
    #shopify-section-{{ section.id }} .ss__image-panel {
      width: 100%;
    }
    #shopify-section-{{ section.id }} .ss__img {
      width: 100%;
      height: auto;
    }
    #shopify-section-{{ section.id }} .ss__heading-1 {
      margin-bottom: {{ s.heading_gap | default: 14 }}px;
      font-size: {{ s.heading_1_size | default: 16 | minus: 2 }}px;
    }
    #shopify-section-{{ section.id }} .ss__headline {
      position: absolute;
      top: 24px;
      left: 24px;
      right: 24px;
      z-index: 5;
      margin: 0;
      width: auto;
      max-width: {%- if s.heading_max_width_mobile and s.heading_max_width_mobile > 0 %} {{ s.heading_max_width_mobile }}px {%- else %} none {%- endif -%};
      font-family: 'Inter', 'Avenir Next', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-weight: 500;
      font-size: 14px;
      line-height: 16px;
      letter-spacing: 0;
      text-transform: {{ s.heading_2_case | default: 'uppercase' }};
      color: {{ s.heading_2_color | default: '#ffffff' }};
      text-align: left;
    }
    #shopify-section-{{ section.id }} .ss__headline .ss__line {
      white-space: normal;
    }
    #shopify-section-{{ section.id }} .ss__headline .ss__word-white,
    #shopify-section-{{ section.id }} .ss__headline .ss__word-grad {
      color: inherit !important;
      -webkit-text-fill-color: inherit !important;
      background: none !important;
      background-image: none !important;
      text-shadow: none !important;
    }
    #shopify-section-{{ section.id }} .ss__copy {
      padding: 16px 4px 0;
      gap: 0;
    }
    #shopify-section-{{ section.id }} .ss__desc {
      position: relative;
      top: 0;
      font-family: 'Inter', 'Avenir Next', 'Helvetica Neue', Helvetica, Arial, sans-serif;
      font-weight: 400;
      font-size: 14px;
      line-height: 18px;
      letter-spacing: 0;
      padding-top: 0;
      {%- if s.desc_max_width_mobile and s.desc_max_width_mobile > 0 %}
      max-width: {{ s.desc_max_width_mobile }}px;
      {%- endif %}
    }
  }
{% endstyle %}

{%- if s.heading_1_typewriter and s.heading_1 != blank -%}
{% style %}
  /* Typewriter — Heading 1 types out then erases on a loop with a
     blinking cursor. Same pattern as Banner 1. */
  #shopify-section-{{ section.id }} .ss__heading-1-text--typewriter {
    white-space: pre-wrap;
  }
  #shopify-section-{{ section.id }} .ss__heading-1-text--typewriter::after {
    content: '|';
    display: inline-block;
    margin-left: 4px;
    animation: ss-tw-cursor-{{ section.id }} 1s step-end infinite;
    color: inherit;
    font-weight: inherit;
  }
  @keyframes ss-tw-cursor-{{ section.id }} {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .ss__heading-1-text--typewriter::after {
      animation: none;
      opacity: 0;
    }
  }
{% endstyle %}
<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var el = root.querySelector('.ss__heading-1-text--typewriter');
    if (!el) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var phrases = [];
    var raw = el.getAttribute('data-typewriter-phrases') || '[]';
    try {
      phrases = JSON.parse(raw);
    } catch (e) {
      console.warn('[spotlight-new-desktop typewriter] JSON parse failed', raw, e);
      phrases = [];
    }
    phrases = phrases
      .map(function (p) { return (p == null ? '' : String(p)).trim(); })
      .filter(function (p) { return p.length > 0; });
    if (!phrases.length) return;

    var typeMs      = {{ s.typewriter_type_speed | default: 80 }};
    var eraseMs     = {{ s.typewriter_erase_speed | default: 40 }};
    var holdFullMs  = {{ s.typewriter_hold_full | default: 2200 }};
    var holdEmptyMs = {{ s.typewriter_hold_empty | default: 600 }};

    var phraseIdx = 0;
    var charIdx   = 0;
    var deleting  = false;

    el.textContent = '';

    function tick() {
      var current = phrases[phraseIdx];
      if (deleting) {
        charIdx--;
        el.textContent = current.substring(0, charIdx);
        if (charIdx <= 0) {
          deleting = false;
          phraseIdx = (phraseIdx + 1) % phrases.length;
          setTimeout(tick, holdEmptyMs);
          return;
        }
        setTimeout(tick, eraseMs);
      } else {
        charIdx++;
        el.textContent = current.substring(0, charIdx);
        if (charIdx >= current.length) {
          deleting = true;
          setTimeout(tick, holdFullMs);
          return;
        }
        setTimeout(tick, typeMs);
      }
    }
    setTimeout(tick, 400);
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Spotlight New Desktop",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Max content width",
      "default": 1200,
      "min": 800,
      "max": 1600,
      "step": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_v",
      "label": "Section vertical padding",
      "default": 60,
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "section_padding_h",
      "label": "Section horizontal padding",
      "default": 24,
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Side margins"
    },
    {
      "type": "range",
      "id": "side_margin_desktop",
      "label": "Side margin – Desktop (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "side_margin_mobile",
      "label": "Side margin – Mobile (px)",
      "min": 0,
      "max": 80,
      "step": 4,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "block_padding",
      "label": "Inner block padding",
      "default": 26,
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between image and text",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "content_padding_left",
      "label": "Content left padding",
      "info": "Extra padding inside the content column. Useful for adding breathing room between the image card and the text without widening the gap.",
      "default": 2,
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image horizontal position",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "image_col_pct",
      "label": "Image size",
      "info": "Image is rendered at its natural aspect ratio. This slider scales the image column's width as a percentage of the block. Increase to make the image bigger.",
      "default": 54,
      "min": 30,
      "max": 80,
      "step": 1,
      "unit": "%"
    },
    {
      "type": "header",
      "content": "Heading 1 (new — sits above)"
    },
    {
      "type": "textarea",
      "id": "heading_1",
      "label": "Heading 1 text",
      "default": "Built for the way you actually live"
    },
    {
      "type": "checkbox",
      "id": "show_heading_dot",
      "label": "Show blinking dot before Heading 1",
      "default": true
    },
    {
      "type": "color",
      "id": "heading_dot_color",
      "label": "Dot color",
      "default": "#01c78e"
    },
    {
      "type": "range",
      "id": "heading_dot_size",
      "label": "Dot size",
      "default": 10,
      "min": 4,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_dot_gap",
      "label": "Gap between dot and text",
      "default": 8,
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "heading_1_color",
      "label": "Heading 1 color",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "heading_1_size",
      "label": "Heading 1 font size",
      "default": 16,
      "min": 10,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "select",
      "id": "heading_1_weight",
      "label": "Heading 1 font weight",
      "default": "500",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "select",
      "id": "heading_1_case",
      "label": "Heading 1 case",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize Each Word" },
        { "value": "none", "label": "As typed" }
      ]
    },
    {
      "type": "checkbox",
      "id": "heading_1_typewriter",
      "label": "Animate Heading 1 as typewriter",
      "info": "Types each phrase character-by-character with a blinking cursor, then erases and rotates to the next phrase. Use | in Heading 1 to define multiple phrases (same as Banner 1's subheading).",
      "default": false
    },
    {
      "type": "range",
      "id": "typewriter_type_speed",
      "label": "Typing speed (ms per character)",
      "info": "Lower = faster typing.",
      "min": 20,
      "max": 200,
      "step": 5,
      "default": 80
    },
    {
      "type": "range",
      "id": "typewriter_erase_speed",
      "label": "Erase speed (ms per character)",
      "min": 10,
      "max": 150,
      "step": 5,
      "default": 40
    },
    {
      "type": "range",
      "id": "typewriter_hold_full",
      "label": "Hold after fully typed (ms)",
      "min": 500,
      "max": 5000,
      "step": 100,
      "default": 2200
    },
    {
      "type": "range",
      "id": "typewriter_hold_empty",
      "label": "Hold before retyping (ms)",
      "min": 100,
      "max": 3000,
      "step": 100,
      "default": 600
    },
    {
      "type": "header",
      "content": "Heading 2 (main headline)"
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Vertical gap between Heading 1 and Heading 2",
      "info": "Negative values pull Heading 2 up so it can overlap Heading 1.",
      "default": 12,
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px"
    },
    {
      "type": "textarea",
      "id": "heading_2",
      "label": "Heading 2 text",
      "info": "Each new line in this box becomes a forced line break. Default matches the reference 3-line layout.",
      "default": "A functional personal care brand that\nprioritises body care for people who\nactually move through their day."
    },
    {
      "type": "color",
      "id": "heading_2_color",
      "label": "Heading 2 color",
      "default": "#111111"
    },
    {
      "type": "select",
      "id": "heading_2_case",
      "label": "Heading 2 case",
      "default": "uppercase",
      "options": [
        { "value": "uppercase", "label": "UPPERCASE" },
        { "value": "lowercase", "label": "lowercase" },
        { "value": "capitalize", "label": "Capitalize Each Word" },
        { "value": "none", "label": "As typed" }
      ]
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading 2 font size",
      "default": 34,
      "min": 20,
      "max": 60,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_line_height_x10",
      "label": "Heading 2 line height",
      "info": "Multiplier × 10 (e.g. 13 = 1.3, 15 = 1.5).",
      "default": 13,
      "min": 9,
      "max": 25,
      "step": 1
    },
    {
      "type": "range",
      "id": "heading_overlap",
      "label": "Heading 2 left overlap (pulls heading over image)",
      "default": 75,
      "min": 0,
      "max": 200,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_max_width",
      "label": "Heading 2 max width — Desktop",
      "info": "Lower it to force the headline to wrap to more lines. Don't go below ~300 or text won't fit on a line.",
      "default": 860,
      "min": 300,
      "max": 1600,
      "step": 20,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_max_width_mobile",
      "label": "Heading 2 max width — Mobile",
      "info": "0 = full container width (current behavior). Set > 0 to constrain the headline width on mobile.",
      "default": 0,
      "min": 0,
      "max": 1000,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Description"
    },
    {
      "type": "textarea",
      "id": "description",
