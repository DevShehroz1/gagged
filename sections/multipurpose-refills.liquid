      "step": 1,
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_gap",
      "label": "Gap below heading (px)",
      "min": 0,
      "max": 120,
      "step": 4,
      "default": 60
    },
    {
      "type": "header",
      "content": "Padding & margin – Desktop"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding – Desktop (px)",
