      "max": 700,
      "step": 4,
      "default": 434
    },
    {
      "type": "range",
      "id": "image_height",
      "label": "Image height (px)",
      "min": 300,
      "max": 900,
      "step": 4,
      "default": 651
    },
    {
      "type": "range",
      "id": "image_radius",
