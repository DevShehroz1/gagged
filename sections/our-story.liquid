{%- liquid
  assign sec_st = section.settings
  if sec_st.reset_spacing
    assign reset_spacing = ' remove_spacing'
  endif
-%}
<div
  class="our-story{{ reset_spacing }}"
  style="background-color: {{ sec_st.bg_color }};"
>
  <div class="our-story__inner">
    <div class="our-story__text">
      <h2 class="our-story__heading">{{ sec_st.heading | escape }}</h2>
      {%- if sec_st.description_1 != blank -%}
        <p class="our-story__desc our-story__desc--1">{{ sec_st.description_1 }}</p>
      {%- endif -%}
      <hr class="our-story__divider">
      {%- if sec_st.description_2 != blank -%}
        <p class="our-story__desc our-story__desc--2">{{ sec_st.description_2 }}</p>
      {%- endif -%}
    </div>
    <div class="our-story__media">
      {%- if sec_st.image != blank -%}
        {%- assign image_alt = sec_st.image.alt | default: sec_st.heading -%}
        {{
          sec_st.image
          | image_url: width: 1440
          | image_tag:
            loading: 'lazy',
            alt: image_alt,
            class: 'our-story__img',
            widths: '720, 1080, 1440',
            sizes: '(max-width: 767px) 100vw, 50vw'
        }}
      {%- else -%}
        {{ 'image' | placeholder_svg_tag: 'our-story__img our-story__img--placeholder' }}
      {%- endif -%}
    </div>
  </div>
</div>

{% style %}
  #shopify-section-{{ section.id }} .our-story {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .our-story__inner {
    display: flex;
    flex-direction: row;
    height: {{ sec_st.section_height }}px;
  }
  #shopify-section-{{ section.id }} .our-story__text {
    flex: 0 0 50%;
    width: 50%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 30px;
    padding-left: 50px;
    padding-right: 50px;
    box-sizing: border-box;
  }
  #shopify-section-{{ section.id }} .our-story__heading {
    font-family: 'Inter', sans-serif;
    font-weight: 500;
    font-size: 40px;
    line-height: 30px;
    letter-spacing: 0;
    text-transform: uppercase;
    color: {{ sec_st.text_color }};
    margin: 0;
    max-width: {{ sec_st.text_max_width }}px;
  }
  #shopify-section-{{ section.id }} .our-story__desc {
    margin: 0;
    color: {{ sec_st.text_color }};
    letter-spacing: 0;
    max-width: {{ sec_st.text_max_width }}px;
  }
  #shopify-section-{{ section.id }} .our-story__desc--1 {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 24px;
  }
  #shopify-section-{{ section.id }} .our-story__divider {
    width: 80px;
    height: 0;
    border: none;
    border-top: 2px solid #BFCED6;
    margin: 0;
    opacity: 1;
  }
  #shopify-section-{{ section.id }} .our-story__desc--2 {
    font-family: 'Inter', sans-serif;
    font-weight: 400;
    font-size: 18px;
    line-height: 20px;
  }
  #shopify-section-{{ section.id }} .our-story__desc--2 br {
    display: block;
    margin-bottom: 14px;
  }
  #shopify-section-{{ section.id }} .our-story__media {
    flex: 0 0 50%;
    width: 50%;
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .our-story__img {
    width: 100%;
    height: {{ sec_st.section_height }}px;
    object-fit: cover;
    border-radius: 0;
    display: block;
  }
  #shopify-section-{{ section.id }} .our-story__img--placeholder {
    height: {{ sec_st.section_height }}px;
    background: #444;
  }
  @media screen and (max-width: 1199px) {
    #shopify-section-{{ section.id }} .our-story__text {
      padding-left: 30px;
      padding-right: 30px;
    }
  }
  @media screen and (max-width: 767px) {
    #shopify-section-{{ section.id }} .our-story__inner {
      flex-direction: column;
      height: auto;
    }
    #shopify-section-{{ section.id }} .our-story__media {
      order: 0;
      flex: none;
      width: 100%;
      padding: 20px 12px 0;
      box-sizing: border-box;
    }
    #shopify-section-{{ section.id }} .our-story__text {
      order: 1;
      flex: none;
      width: 100%;
      padding: 30px 20px 50px;
      gap: 20px;
    }
    #shopify-section-{{ section.id }} .our-story__img {
      height: 320px;
      border-radius: 14px;
    }
    #shopify-section-{{ section.id }} .our-story__heading {
      font-size: 28px;
      line-height: 34px;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Our Story",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#2B2E22"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Story"
    },
    {
      "type": "textarea",
      "id": "description_1",
      "label": "First paragraph (20px)",
      "default": "What if fragrance worked with the skin, body care was treated like skincare, only what runs out was replaced, and everything was built for this climate?"
    },
    {
      "type": "textarea",
      "id": "description_2",
      "label": "Second paragraph (18px)",
      "default": "Most products solved one thing while ignoring the rest. Fragrance that faded fast, formulas that worked but felt harsh, packaging replaced again and again. It felt like a loop no one questioned.\nSo we started from scratch, with a standard. Body care that lasts without compromising skin. Scent that evolves, not disappears. A system where you keep what works and replace only what runs out. Built for real, everyday life."
    },
    {
      "type": "range",
      "id": "text_max_width",
      "label": "Text max width",
      "default": 380,
      "min": 200,
      "max": 700,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "section_height",
      "label": "Section height",
      "default": 600,
      "min": 300,
      "max": 1000,
      "step": 10,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "reset_spacing",
      "label": "Remove section spacing",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Our Story"
    }
  ]
}
{% endschema %}
