{%- liquid
  assign st = section.settings
-%}

<style>
  #tagline-strip-{{ section.id }} {
    background: {{ st.bg_color | default: '#363b48' }};
    color: {{ st.text_color | default: '#fff8b8' }};
    text-align: center;
    margin-top: {{ st.margin_top_desktop | default: 0 }}px;
    margin-bottom: {{ st.margin_bottom_desktop | default: 0 }}px;
    padding-top: {{ st.padding_top_desktop | default: 16 }}px;
    padding-bottom: {{ st.padding_bottom_desktop | default: 16 }}px;
    padding-left: {{ st.side_padding_desktop | default: 24 }}px;
    padding-right: {{ st.side_padding_desktop | default: 24 }}px;
  }
  #tagline-strip-{{ section.id }} .tagline-strip__text {
    font-family: 'Inter', sans-serif;
    font-weight: {{ st.font_weight | default: 700 }};
    font-size: {{ st.font_size_desktop | default: 16 }}px;
    line-height: 1.3;
    letter-spacing: {{ st.letter_spacing | default: 0.06 }}em;
    text-transform: {{ st.text_transform | default: 'uppercase' }};
    margin: 0;
    color: inherit;
  }
  @media (max-width: 767.98px) {
    #tagline-strip-{{ section.id }} {
      margin-top: {{ st.margin_top_mobile | default: 0 }}px;
      margin-bottom: {{ st.margin_bottom_mobile | default: 0 }}px;
      padding-top: {{ st.padding_top_mobile | default: 12 }}px;
      padding-bottom: {{ st.padding_bottom_mobile | default: 12 }}px;
      padding-left: {{ st.side_padding_mobile | default: 16 }}px;
      padding-right: {{ st.side_padding_mobile | default: 16 }}px;
    }
    #tagline-strip-{{ section.id }} .tagline-strip__text {
      font-size: {{ st.font_size_mobile | default: 13 }}px;
    }
  }
</style>

<div id="tagline-strip-{{ section.id }}">
  {%- if st.text != blank -%}
    <p class="tagline-strip__text">{{ st.text }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Tagline Strip",
  "tag": "section",
  "class": "tagline-strip-section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "BUILT FOR HEAT. BUILT FOR MOVEMENT."
    },
    {
      "type": "select",
      "id": "text_transform",
      "label": "Text case",
      "options": [
        { "value": "uppercase", "label": "Uppercase" },
        { "value": "capitalize", "label": "Capitalize" },
        { "value": "lowercase", "label": "Lowercase" },
        { "value": "none", "label": "Original" }
      ],
      "default": "uppercase"
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        { "value": "400", "label": "Regular" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semibold" },
        { "value": "700", "label": "Bold" }
      ],
      "default": "700"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#363b48"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#fff8b8"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size_desktop",
      "label": "Font size – Desktop",
      "min": 10,
      "max": 36,
      "step": 1,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "label": "Font size – Mobile",
      "min": 10,
      "max": 28,
      "step": 1,
      "default": 13,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing (em)",
      "min": 0,
      "max": 0.2,
      "step": 0.01,
      "default": 0.06
    },
    {
      "type": "header",
      "content": "Padding – Desktop"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Top padding – Desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding – Desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "side_padding_desktop",
      "label": "Side padding – Desktop",
      "min": 0,
      "max": 100,
      "step": 2,
      "default": 24,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Padding – Mobile"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding – Mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding – Mobile",
      "min": 0,
      "max": 80,
      "step": 2,
      "default": 12,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "side_padding_mobile",
      "label": "Side padding – Mobile",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 16,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Margin – Desktop"
    },
    {
      "type": "range",
      "id": "margin_top_desktop",
      "label": "Top margin – Desktop",
      "min": -100,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom_desktop",
      "label": "Bottom margin – Desktop",
      "min": -100,
      "max": 100,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Margin – Mobile"
    },
    {
      "type": "range",
      "id": "margin_top_mobile",
      "label": "Top margin – Mobile",
      "min": -80,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "margin_bottom_mobile",
      "label": "Bottom margin – Mobile",
      "min": -80,
      "max": 80,
      "step": 2,
      "default": 0,
      "unit": "px"
    }
  ],
  "presets": [
    {
      "name": "Tagline Strip"
    }
  ]
}
{% endschema %}
